[submodule "SDKs/dawn"]
	path = SDKs/dawn
	url = https://github.com/google/dawn.git
	shallow = true
[submodule "SDKs/assimp"]
	path = SDKs/assimp
	url = https://github.com/assimp/assimp.git
	shallow = true
[submodule "SDKs/yaml-cpp"]
	path = SDKs/yaml-cpp
	url = https://github.com/jbeder/yaml-cpp.git
[submodule "SDKs/json"]
	path = SDKs/json
	url = https://github.com/nlohmann/json.git
[submodule "SDKs/PhysX"]
	path = SDKs/PhysX
	url = https://github.com/fabmax/physx-js-webidl.git
